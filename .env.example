# Razorpay Merchant Churn Early-Warning Agent Environment Variables
# The system works completely without an API key using deterministic fallback templates!
# Set your Claude (Anthropic) API key:

LLM_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Alternatively: CLAUDE_API_KEY=your_key_here

# Alternatively for Gemini or OpenAI:
# LLM_PROVIDER=gemini
# MODEL_NAME=gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
#
# LLM_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
